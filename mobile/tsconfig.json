{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": []
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__"
  ]
}
